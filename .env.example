# Copy to .env (Prisma CLI and Next.js both read it). Never commit .env.
# Docker Compose local development database; URL-encode special password characters.
DATABASE_URL="mysql://mnw:local_dev_password@127.0.0.1:3306/mynextwatch"
# Maximum connections PER running application instance. Keep low on Vercel.
DATABASE_POOL_SIZE="2"
# For remote MySQL set true; certificate verification is never disabled.
DATABASE_SSL="false"
# Optional PEM CA certificate for a database with a private certificate authority.
DATABASE_SSL_CA=""
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# GitHub Settings > Developer settings > OAuth Apps > New OAuth App.
# Callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# TMDB account > Settings > API > API Read Access Token (not the v3 API key).
TMDB_READ_ACCESS_TOKEN=""
# Random secret protecting the daily Vercel maintenance route; generate like AUTH_SECRET.
CRON_SECRET=""
# Optional: dedicated disposable database only. The database name MUST end in _test.
TEST_DATABASE_URL="mysql://mnw_test:local_test_password@127.0.0.1:3307/mynextwatch_test"
