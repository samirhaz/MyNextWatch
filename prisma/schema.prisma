generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum MediaType {
  movie
  tv
}

enum TrackingStatus {
  PLAN_TO_WATCH
  WATCHING
  COMPLETED
  ON_HOLD
  DROPPED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  preference    UserPreference?
  library       LibraryEntry[]
  lists         CustomList[]
  shares        ShareLink[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@id([identifier, token])
  @@unique([identifier, token])
}

model UserPreference {
  userId    String   @id
  country   String   @default("US") @db.Char(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Title {
  id                 String    @id @default(cuid())
  tmdbId             Int
  mediaType          MediaType
  name               String    @db.VarChar(500)
  overview           String    @db.Text
  posterPath         String?
  backdropPath       String?
  releaseDate        String?   @db.VarChar(10)
  communityRating    Float?
  genres             Json
  runtime            Int?
  seasons            Json?
  providers          Json?
  providersUpdatedAt DateTime?
  metadataUpdatedAt  DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  library            LibraryEntry[]
  listItems          ListItem[]
  @@unique([mediaType, tmdbId])
  @@index([name])
  @@index([releaseDate])
}

model LibraryEntry {
  id           String         @id @default(cuid())
  userId       String
  titleId      String
  status       TrackingStatus @default(PLAN_TO_WATCH)
  rating       Int?            @db.UnsignedTinyInt
  notes        String?        @db.Text
  season       Int            @default(1)
  episode      Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        Title          @relation(fields: [titleId], references: [id], onDelete: Cascade)
  @@unique([userId, titleId])
  @@index([userId, status, createdAt])
  @@index([titleId])
}

model CustomList {
  id          String     @id @default(cuid())
  userId      String
  name        String     @db.VarChar(100)
  description String?    @db.VarChar(500)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ListItem[]
  share       ShareLink?
  @@index([userId, createdAt])
}

model ListItem {
  id        String     @id @default(cuid())
  listId    String
  titleId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  list      CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)
  title     Title      @relation(fields: [titleId], references: [id], onDelete: Cascade)
  @@unique([listId, titleId])
  @@index([titleId])
}

// scope = "watchlist" or the custom list ID. Only a hash of the bearer token is stored.
model ShareLink {
  id        String      @id @default(cuid())
  userId    String
  scope     String
  listId    String?     @unique
  tokenHash String      @unique @db.Char(64)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  list      CustomList? @relation(fields: [listId], references: [id], onDelete: Cascade)
  @@unique([userId, scope])
}

// Shared by all application instances; unlike an in-memory limiter this survives cold starts.
model RateLimit {
  key       String   @id @db.VarChar(100)
  count     Int      @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
